---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title = 'Panatlantic Logistics S.A. | Operador logístico líder en el Ecuador' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="icon" href="/favicon.ico" />
		<meta
			name="description"
			content="Operador logístico nacional e internacional con más de 40 años: carga aérea, marítima y terrestre, aduanas, almacenamiento, distribución y seguros."
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>

</style>
